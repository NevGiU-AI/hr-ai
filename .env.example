# Local development only. Copy to .env and keep the completed file private.
OPENAI_API_KEY=

# Used only to create the first local administrator. Choose a local-only
# password of at least 12 characters, then remove it after confirming login.
APP_SECURITY_BOOTSTRAP_ADMIN_EMAIL=admin@localhost
APP_SECURITY_BOOTSTRAP_ADMIN_PASSWORD=
APP_SECURITY_BOOTSTRAP_ADMIN_ORGANIZATION=local

# Local Docker uses HTTP. Staging and production force secure cookies on HTTPS.
APP_SECURITY_SECURE_COOKIE=false
APP_SECURITY_SESSION_TIMEOUT=30m

# Local Compose supplies a development-only Redis password. Direct backend
# launches use these defaults unless explicitly overridden.
APP_REDIS_HOST=localhost
APP_REDIS_PORT=6379
APP_REDIS_PASSWORD=local-redis-secret
APP_REDIS_SESSION_NAMESPACE=hr-ai:session:local
APP_REDIS_SECURITY_NAMESPACE=hr-ai:security:login:local
APP_SECURITY_LOGIN_ACCOUNT_FAILURE_LIMIT=5
APP_SECURITY_LOGIN_IP_FAILURE_LIMIT=20
APP_SECURITY_LOGIN_FAILURE_WINDOW=15m
APP_SECURITY_LOGIN_LOCK_DURATION=15m
APP_SECURITY_AUDIT_RETENTION=365d

# Original CVs are written to ./data/cv-originals by local Docker. Retention cleanup is bounded and legal holds remain
# authoritative; use disposable data when exercising expiry in development.
APP_CV_STORAGE_RETENTION=365d
APP_CV_RETENTION_CLEANUP_ENABLED=true
APP_CV_RETENTION_CLEANUP_BATCH_SIZE=100
APP_CV_RETENTION_CLEANUP_CRON=0 43 3 * * *
APP_CV_MALWARE_CONNECT_TIMEOUT=2s
APP_CV_MALWARE_READ_TIMEOUT=30s
APP_CV_OCR_ENABLED=true
APP_CV_OCR_LANGUAGES=eng+fra+por
APP_CV_OCR_DPI=300
APP_CV_OCR_MAX_PAGES=30
APP_CV_OCR_PAGE_TIMEOUT=30s
APP_CV_OCR_MINIMUM_CONFIDENCE=70

# Bounded candidate-chat evidence defaults. Semantic indexing and retrieval are separate switches because local
# indexing calls the configured embedding provider and may incur cost. Enable both only when testing the accepted
# pgvector retrieval path; staging and production accepted six matches and a 0.35 threshold on 30 October 2026.
APP_CV_CHAT_MAX_EVIDENCE_PAGES=10
APP_CV_CHAT_MAX_EXCERPT_CHARACTERS=1200
APP_CV_CHAT_SEMANTIC_RETRIEVAL_ENABLED=false
APP_CV_CHAT_SEMANTIC_MAX_MATCHES=6
APP_CV_CHAT_SEMANTIC_MIN_SIMILARITY=0.35
APP_CV_SEMANTIC_INDEX_ENABLED=false
APP_CV_SEMANTIC_EMBEDDING_MODEL=text-embedding-3-small
APP_CV_SEMANTIC_CHUNK_CHARACTERS=1200
APP_CV_SEMANTIC_CHUNK_OVERLAP=200
APP_CV_SEMANTIC_MAX_CHUNKS_PER_DOCUMENT=100
APP_CV_SEMANTIC_EMBEDDING_BATCH_SIZE=32
APP_CV_SEMANTIC_RECONCILIATION_BATCH_SIZE=50
APP_CV_SEMANTIC_RECONCILIATION_CRON=0 11 * * * *

# Immutable GHCR digests are required after CI/CD is enabled.
# Local tags can be used for the first manual staging deployment.
BACKEND_IMAGE=hr-ai-backend:staging-manual
FRONTEND_IMAGE=hr-ai-frontend:staging-manual

FRONTEND_HOST=staging-hr.nevgiuai.com
API_HOST=staging-api.hr.nevgiuai.com
FRONTEND_URL=https://staging-hr.nevgiuai.com
ACME_EMAIL=

POSTGRES_DB=hr_ai
POSTGRES_USER=hr_user
POSTGRES_PASSWORD=
# Non-secret placeholder so `docker compose config` works in CI. Replace it in
# every private environment file with a unique random value before deployment.
REDIS_PASSWORD=replace-with-a-random-environment-secret
REDIS_SESSION_NAMESPACE=hr-ai:session:staging
REDIS_SECURITY_NAMESPACE=hr-ai:security:login:staging
OPENAI_API_KEY=

# Flyway owns schema changes; enable its baseline flag only for one-time adoption on an existing database.
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
FLYWAY_BASELINE_ON_MIGRATE=false

# Enable only in staging when the packaged demonstration CVs are needed.
INITIAL_IMPORT_ENABLED=true
CV_STORAGE_RETENTION=365d
CV_RETENTION_CLEANUP_ENABLED=true
CV_RETENTION_CLEANUP_BATCH_SIZE=100
CV_RETENTION_CLEANUP_CRON=0 43 3 * * *
CV_MALWARE_CONNECT_TIMEOUT=2s
CV_MALWARE_READ_TIMEOUT=30s
CV_OCR_ENABLED=true
CV_OCR_LANGUAGES=eng+fra+por
CV_OCR_DPI=300
CV_OCR_MAX_PAGES=30
CV_OCR_PAGE_TIMEOUT=30s
CV_OCR_MINIMUM_CONFIDENCE=70

# Required only for the first secured startup. Remove the password after the
# administrator is created; the account remains in PostgreSQL.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_ORGANIZATION=default
SESSION_TIMEOUT=30m
SECURITY_MAXIMUM_SESSIONS=3
LOGIN_ACCOUNT_FAILURE_LIMIT=5
LOGIN_IP_FAILURE_LIMIT=20
LOGIN_FAILURE_WINDOW=15m
LOGIN_LOCK_DURATION=15m
SECURITY_AUDIT_RETENTION=365d
